# SMIVAI backend — local environment. Copy to .env (never commit real values).
# The service reads these from the process environment; set them in your shell
# or with a tool such as `uvicorn --env-file backend/.env`.

# PostgreSQL URL. If unreachable, a local SQLite file next to backend/ is used.
SMIVAI_DATABASE_URL=postgresql+psycopg://smivai:smivai@localhost:5432/smivai

# HMAC secret for session tokens. Without it a random per-process secret is
# used and every session ends when the server restarts.
# SMIVAI_AUTH_SECRET=

# Salt for identity hashes. Must match the device salt (js/core/auth.js).
SMIVAI_ID_SALT=smivai-device-v1

# HUN advanced conversations (POST /ai/chat). Leave empty to keep it off.
# ANTHROPIC_API_KEY=
SMIVAI_AI_MODEL=claude-opus-5-5
SMIVAI_AI_TIMEOUT=30

# Bhashini / ULCA language services (translation, TTS, ASR).
# SMIVAI_BHASHINI_USER_ID=
# SMIVAI_BHASHINI_API_KEY=
# SMIVAI_BHASHINI_PIPELINE=
# SMIVAI_AI4BHARAT_BASE=

# No SMS provider is connected. Set to 1 to let /auth/start return the code
# (labelled "Demo mode") so sign-in can be tested locally. Without it the API
# refuses to start a sign-in rather than pretend a message was sent.
SMIVAI_DEMO_OTP=1

# Browser origins allowed to call the API (comma-separated).
SMIVAI_CORS_ORIGINS=http://localhost:8123,http://127.0.0.1:8123

# Accept the old X-SMIVAI-Role / X-SMIVAI-Actor headers (local dev only).
SMIVAI_ALLOW_HEADER_AUTH=0

# Charity assistance (docs/CHARITY.md). Income must be strictly below this.
SMIVAI_CHARITY_INCOME_LIMIT_RUPEES=150000
# Private folder for uploaded income documents (never inside a web root).
# SMIVAI_UPLOAD_DIR=backend/private_uploads

# Donations — Razorpay TEST mode only. Leave empty for Demo mode (nothing can be paid).
# A live key (rzp_live_…) is refused until legal and merchant approvals exist.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
